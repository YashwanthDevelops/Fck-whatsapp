# Local development only. Copy to .env before starting Docker Compose.
SYNAPSE_SERVER_NAME=localhost
SYNAPSE_BIND_ADDRESS=127.0.0.1
SYNAPSE_HTTP_PORT=8008
SYNAPSE_PUBLIC_BASEURL=http://localhost:8008/
SYNAPSE_REPORT_STATS=no

# Use 10.0.2.2 from the Android emulator to reach this Windows host.
# For a physical phone on a trusted LAN, set SYNAPSE_BIND_ADDRESS to the
# host's private LAN address and allow the port only on that private network.
