# Copy this file to .env on the private server, then replace MATRIX_DOMAIN
# with the stable public DNS name you own. This .invalid value is not deployable.
MATRIX_DOMAIN=replace-with-your-owned-domain.invalid

# Create this file on the server with a long random value and mode 0600.
POSTGRES_PASSWORD_FILE=./secrets/postgres_password

# Version tags are pinned here. Review security releases before upgrades;
# pin image digests as part of production change control.
SYNAPSE_IMAGE=ghcr.io/element-hq/synapse:v1.161.0
POSTGRES_IMAGE=postgres:16.15-alpine
CADDY_IMAGE=caddy:2.11.4-alpine
SYGNAL_IMAGE=matrixdotorg/sygnal:v0.17.0
