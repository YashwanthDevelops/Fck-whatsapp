# Copy this file to .env on the private server, then set MATRIX_DOMAIN to the
# stable public DNS name you own. Calls are optional and do not need setup for
# the messenger profile.
MATRIX_DOMAIN=replace-with-your-owned-domain.invalid

# Create this file on the server with a long random value and mode 0600.
POSTGRES_PASSWORD_FILE=./secrets/postgres_password

# Encrypted off-host backup settings. Keep the matching age identity offline,
# separate from this server. Mount BACKUP_DIR from a protected backup destination.
BACKUP_DIR=/mnt/encrypted-backups/friendline
BACKUP_AGE_RECIPIENT=age1replace-with-a-public-recipient

# Version tags are pinned here. Review security releases before upgrades;
# pin image digests as part of production change control.
SYNAPSE_IMAGE=ghcr.io/element-hq/synapse:v1.161.0
POSTGRES_IMAGE=postgres:16.15-alpine
CADDY_IMAGE=caddy:2.11.4-alpine
SYGNAL_IMAGE=matrixdotorg/sygnal:v0.17.0
# Optional for the calls profile only:
# CALLS_DOMAIN=calls.replace-with-your-owned-domain.invalid
# LIVEKIT_KEYS_FILE=./secrets/livekit_keys.yaml
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.7
