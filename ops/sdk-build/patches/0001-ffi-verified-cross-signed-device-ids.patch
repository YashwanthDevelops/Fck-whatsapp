+#[cfg(test)]
+mod verified_cross_signed_device_ids_tests {
+    use super::{filter_cross_signed_device_ids, identity_is_safe_for_device_query};
+
+    #[test]
+    fn peer_identity_must_be_verified_and_have_no_violation() {
+        assert!(identity_is_safe_for_device_query(true, false));
+        assert!(!identity_is_safe_for_device_query(false, false));
+        assert!(!identity_is_safe_for_device_query(true, true));
+        assert!(!identity_is_safe_for_device_query(false, true));
+    }
+
+    #[test]
+    fn only_cross_signed_devices_are_returned() {
+        let ids = filter_cross_signed_device_ids([
+            ("verified-a".to_owned(), true),
+            ("unverified".to_owned(), false),
+            ("verified-b".to_owned(), true),
+        ]);
+
+        assert_eq!(ids, vec!["verified-a".to_owned(), "verified-b".to_owned()]);
+    }
+}
