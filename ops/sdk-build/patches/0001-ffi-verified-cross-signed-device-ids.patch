+/// Return only devices that are cross-signing trusted after requiring a
+/// present, verified identity with no outstanding verification violation.
+fn filter_cross_signed_device_ids(
+    devices: impl IntoIterator<Item = (String, bool)>,
+) -> Vec<String> {
+    devices
+        .into_iter()
+        .filter_map(|(device_id, is_cross_signed)| is_cross_signed.then_some(device_id))
+        .collect()
+}
+
+fn identity_is_safe_for_device_query(is_verified: bool, has_verification_violation: bool) -> bool {
+    is_verified && !has_verification_violation
+}
