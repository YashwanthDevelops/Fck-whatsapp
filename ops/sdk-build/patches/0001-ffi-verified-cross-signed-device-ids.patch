+    /// Query the homeserver for a fresh peer identity and return the device IDs
+    /// whose device keys are trusted by cross-signing.
+    ///
+    /// Fails closed if the identity is absent, unverified, or has a
+    /// verification violation. Callers must still send encrypted to-device
+    /// events only to these explicit device IDs; this method does not authorize
+    /// wildcard device selectors.
+    pub async fn verified_cross_signed_device_ids_for_user(
+        &self,
+        user_id: String,
+    ) -> Result<Vec<String>, ClientError> {
+        let user_id = user_id.as_str().try_into()?;
+        let identity = self.inner.request_user_identity(user_id).await?.ok_or_else(|| {
+            ClientError::Generic {
+                msg: "Peer has no cross-signing identity".to_owned(),
+                details: None,
+            }
+        })?;
+
+        if !identity_is_safe_for_device_query(
+            identity.is_verified(),
+            identity.has_verification_violation(),
+        ) {
+            return Err(ClientError::Generic {
+                msg: "Peer identity is not verified or has a verification violation".to_owned(),
+                details: None,
+            });
+        }
+
+        let devices = self.inner.get_user_devices(user_id).await?;
+        Ok(filter_cross_signed_device_ids(devices.devices().map(|device| {
+            (device.device_id().to_string(), device.is_verified_with_cross_signing())
+        })))
+    }
